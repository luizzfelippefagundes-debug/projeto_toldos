# Bot de atendimento (Central do Bot) — usa o Gemini pra responder perguntas.
# Pegue sua chave em https://aistudio.google.com/apikey e configure via
# `vercel env add GOOGLE_GENERATIVE_AI_API_KEY` (produção) ou aqui em
# .env.local (dev local, nunca commitado). Sem essa chave, a Central do
# Bot continua mostrando as mensagens automáticas normalmente — só o
# "Testar bot" (pergunta livre) fica indisponível.
GOOGLE_GENERATIVE_AI_API_KEY=

# Bot de atendimento no WhatsApp (ver app/api/whatsapp/webhook) — usa o
# GPT-4.1 da OpenAI. Crie a chave em https://platform.openai.com e configure
# via `vercel env add OPENAI_API_KEY` (produção) ou em .env.local (dev).
OPENAI_API_KEY=

# Evolution API (servidor próprio, self-hosted) — conecta o número de
# WhatsApp da loja. EVOLUTION_INSTANCE é o nome da instância criada pra essa
# loja; EVOLUTION_WEBHOOK_SECRET é o segredo que o Evolution manda em
# x-webhook-secret (ou ?secret=) pra autenticar as chamadas no nosso webhook.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
